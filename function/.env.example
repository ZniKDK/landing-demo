# Переменные окружения функции.
# В облаке значения вписываются в консоли Yandex Cloud (Функция → Редактор → Переменные окружения).
# Для локального запуска: скопируйте файл в function/.env и заполните. .env в git не попадает.

# Токен бота от @BotFather и id чата, куда слать заявки
TG_BOT_TOKEN=
TG_CHAT_ID=

# Запасной канал — почта (Яндекс: пароль приложения, не пароль от ящика)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Откуда принимаем заявки и куда возвращаем посетителя без JS
ALLOWED_ORIGIN=https://znikdk.github.io
SITE_URL=https://znikdk.github.io/landing-demo/
SITE_NAME=ШинТочка

# 1 — только локально: заявки печатаются в консоль и никуда не отправляются
DRY_RUN=
