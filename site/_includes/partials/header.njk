{% from "partials/icons.njk" import icon %}
<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/">
      <img src="/favicon.svg" width="34" height="34" alt="">
      <span>{{ site.name }}</span>
    </a>
    <nav class="nav" aria-label="Разделы">
      {%- for item in site.nav %}
      <a href="/{{ item.href }}">{{ item.text }}</a>
      {%- endfor %}
    </nav>
    <a class="header__phone" href="tel:{{ site.contact.phone }}" aria-label="Позвонить: {{ site.contact.phoneDisplay }}">
      {{ icon('phone', 20) }}<span class="header__phone-text">{{ site.contact.phoneDisplay }}</span>
    </a>
    {#- Переключатель темы: как в системе → светлая → тёмная (логика в theme.js) #}
    <button class="theme-btn" type="button" data-theme-toggle aria-label="Сменить тему">
      <svg class="ico ico-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
      <svg class="ico ico-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="ico ico-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    </button>
    <a class="btn btn--primary header__cta" href="/#form">{{ site.hero.cta }}</a>
  </div>
</header>
