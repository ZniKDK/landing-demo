{% from "partials/icons.njk" import icon %}
<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/">
      <img src="/favicon.svg" width="32" height="32" alt="">
      <span>{{ site.name }}</span>
    </a>
    <a class="header__phone" href="tel:{{ site.contact.phone }}" aria-label="Позвонить: {{ site.contact.phoneDisplay }}">
      {{ icon('phone', 20) }}<span class="header__phone-text">{{ site.contact.phoneDisplay }}</span>
    </a>
    <a class="btn btn--primary header__cta" href="#form">{{ site.hero.cta }}</a>
  </div>
</header>
